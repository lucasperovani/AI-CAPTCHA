# AI-CAPTCHA Configuration

# Server Port
PORT=3000

# Level 1 Time Limit (in milliseconds)
# Default: 5000ms (5 seconds)
# This should be fast enough for machines but too fast for humans to calculate manually
LEVEL1_TIME_LIMIT_MS=5000

# Level 2 Time Limit (in milliseconds)
# Default: 5000ms (5 seconds)
# Allows AI agents to query but restricts human manual research
LEVEL2_TIME_LIMIT_MS=5000

# AI API Configuration (Optional)
# If not provided, uses fallback pre-configured questions

# Your API Key (OpenAI, Claude, Gemini, etc.)
AI_API_KEY=

# API Host
# For OpenAI: api.openai.com
# For other providers, adjust accordingly
AI_API_HOST=api.openai.com

# AI Model to use
# For OpenAI: gpt-3.5-turbo, gpt-4, etc.
# For Claude: claude-3-sonnet, etc.
AI_API_MODEL=gpt-3.5-turbo
